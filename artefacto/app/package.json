{
  "name": "modelo-fv-montecristi-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Front-end shell (F3 plumbing) del artefacto interactivo Modelo FV Montecristi → GPM",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:format": "tsx test/format.test.ts",
    "build:bundle": "bash \"${WEB_ARTIFACTS_SKILL:-/mnt/skills/examples/web-artifacts-builder}/scripts/bundle-artifact.sh\"",
    "build:fragment": "node scripts/to-fragment.mjs",
    "build:all": "npm run make:externo && npm run select:edition && npm run build:bundle && npm run build:fragment",
    "build:interno": "rm -rf .parcel-cache && VITE_EDITION=interno npm run build:all",
    "build:externo": "rm -rf .parcel-cache && VITE_EDITION=externo npm run build:all",
    "build:editions": "npm run build:interno && npm run build:externo && npm run check:exclusion",
    "check:exclusion": "node scripts/check-exclusion.mjs",
    "smoke": "node scripts/smoke.mjs interno && node scripts/smoke.mjs externo",
    "make:externo": "python3 scripts/make-externo.py",
    "select:edition": "node scripts/select-edition.mjs",
    "release": "bash scripts/release.sh"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@parcel/config-default": "^2.16.4",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "html-inline": "^1.2.0",
    "oxlint": "^1.79.0",
    "parcel": "^2.16.4",
    "parcel-resolver-tspaths": "^0.0.9",
    "parse5": "^7.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}